{
  "name": "@elise/dashboard",
  "version": "0.1.14",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "build:demo": "tsc -b && vite build --mode demo",
    "i18n:check": "elise-i18n-check src/i18n/locales --code src"
  },
  "dependencies": {
    "@elise/contracts": "workspace:*",
    "@elise/i18n": "workspace:*",
    "@elise/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "hls.js": "^1.7.4",
    "i18next": "^26.7.1",
    "lucide-react": "^1.66.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.11",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
