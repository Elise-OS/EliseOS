{
  "name": "michel-os",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first home reassurance platform for families and caregivers.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @michel/api prisma:generate",
    "db:migrate": "pnpm --filter @michel/api prisma:migrate",
    "dev:dashboard": "bash scripts/dev-dashboard.sh",
    "deploy:nas": "bash scripts/deploy-nas.sh",
    "nas:status": "bash scripts/nas-status.sh",
    "nas:reset-db": "bash scripts/nas-reset-database.sh",
    "nas:clean-install": "bash scripts/nas-clean-install.sh",
    "zigbee:detect": "bash scripts/detect-zigbee-adapter.sh --write-env .env",
    "test:zigbee-detection": "bash scripts/detect-zigbee-adapter.test.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yaml,yml,css}": "prettier --write"
  }
}
