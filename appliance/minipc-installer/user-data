#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: false
  # The early command replaces these four exact tokens, then Subiquity reloads this file.
  locale: __ELISE_LOCALE__
  keyboard:
    layout: __ELISE_KEYBOARD__
    variant: ""
  timezone: __ELISE_TIMEZONE__
  identity:
    hostname: elise
    username: elise
    realname: Élise OS
    password: "!"
  ssh:
    install-server: false
    authorized-keys: []
    allow-pw: false
  # Keep Subiquity's documented default: DHCP on eth*/en* during installation. The late
  # command writes the same wildcard policy into the target so a PCI name change is harmless.
  storage:
    layout:
      name: direct
      match:
        path: __ELISE_TARGET_DISK__
  early-commands:
    # Subiquity runs commands inside its snap: there `python3` is the snap's Python 3.10 with the
    # snap's PYTHONPATH/LD_LIBRARY_PATH, and the vendored Pillow (cp312) cannot load, which drops
    # the screens to plain text. Run the live system's own Python 3.12 in a clean environment.
    - env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 /usr/bin/python3 -E /cdrom/nocloud/select-target.py
  late-commands:
    - bash /cdrom/nocloud/install-target.sh /target
  updates: security
  shutdown: reboot
  error-commands:
    # The progress screen (installer_ui.monitor) turns into the error screen on this mark.
    # First the failed step and its error, for the error screen and a report on the USB stick;
    # then the bare mark, should that script be unable to run.
    - env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LANG=C.UTF-8 /usr/bin/python3 -E /cdrom/nocloud/report-failure.py || true
    - sh -c 'mkdir -p /run/elise-installer && touch /run/elise-installer/failed || true'
    - >-
      sh -c 'echo "ELISE_INSTALLER: ERROR — installation stopped; no automatic retry" |
      tee /dev/console /dev/ttyS0 >/dev/null 2>&1 || true'
