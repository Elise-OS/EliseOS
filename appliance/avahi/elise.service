<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<!-- Announces the installed Élise to the mobile app; it then verifies /api/v1/discovery. -->
<service-group>
  <name>Élise OS</name>
  <service>
    <type>_michel._tcp</type>
    <port>@PORT@</port>
    <txt-record>path=/api/v1/discovery</txt-record>
    <txt-record>port=@PORT@</txt-record>
  </service>
</service-group>
