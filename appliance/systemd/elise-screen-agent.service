[Unit]
Description=Élise display and optional network agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
[Service]
ExecStart=/usr/bin/python3 /usr/lib/elise/elise-screen-agent.py
Restart=always
RestartSec=3
RuntimeDirectory=elise-screen
RuntimeDirectoryMode=0755
UMask=0077
[Install]
WantedBy=multi-user.target
