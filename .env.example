ELISE_VERSION=0.1.35
ELISE_HTTP_PORT=8080
ELISE_TAILSCALE_PROXY_PORT=18080
ELISE_LOCAL_URL=http://elise.local:8080
ELISE_REMOTE_URL=
ELISE_AGENT_RUN_DIR=/run/elise-remote-access
ELISE_AGENT_GID=995
ELISE_WEBRTC_BIND=0.0.0.0
ELISE_WEBRTC_CANDIDATE=
ELISE_HA_MAINTENANCE_PORT=8124
ELISE_Z2M_MAINTENANCE_PORT=18081
ELISE_DEMO_MODE=false
ELISE_SIMULATION_MODE=false
TOPOLOGY_TRACKING_ENABLED=true
ELISE_HOME_ID=home_demo
ELISE_DISCOVERY_NAME=Élise OS
ELISE_DISCOVERY_HOST=
# Pinned by the Raspberry Pi first boot so the mobile app keeps one identity; leave empty elsewhere.
ELISE_INSTANCE_ID=
# Optional extra browser origins for Expo Web. localhost:8081 and :8082 are allowed by default.
# Add the exact origin (scheme, host and port), e.g. http://192.168.1.20:8081.
ELISE_WEB_CORS_ORIGINS=
MATTER_SERVER_ENABLED=false
ZWAVE_SERVER_ENABLED=false
BLUETOOTH_ENABLED=true
ESPHOME_ONBOARDING_ENABLED=false
HA_CONFIG_FLOW_ENABLED=false
TZ=Europe/Paris
ZIGBEE_ADAPTER_MODE=auto
ZIGBEE_ADAPTER=/dev/null
ZIGBEE_ADAPTER_TYPE=auto
# Written by the "Clé Zigbee" settings tab: network key (tcp://host:6638), speed, flow control.
# ZIGBEE_SERIAL_PORT=
# ZIGBEE_BAUDRATE=
# ZIGBEE_RTSCTS=
WEBHOOK_URL=
WEBHOOK_SECRET=
ELISE_BACKUP_RECIPIENT=

# Resident screen: URL and secret are generated automatically after Tailscale pairing.

# YouTube account connection (Google Cloud OAuth 2.0 Web application).
# The YouTube Data API v3 must be enabled for the Google project.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional when ELISE_REMOTE_URL is set; otherwise use the exact public callback URL.
YOUTUBE_REDIRECT_URI=
ELISE_JITSI_URL=
ELISE_JITSI_SECRET=
# The complete first installation includes HDMI/DisplayPort, Chromium and Jitsi.
ELISE_SCREEN_ENABLED=true
