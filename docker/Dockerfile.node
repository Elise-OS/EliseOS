FROM node:24-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl && rm -rf /var/lib/apt/lists/* \
  && corepack enable && corepack prepare pnpm@11.10.0 --activate
WORKDIR /workspace

FROM base AS dependencies
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/package.json
COPY apps/dashboard/package.json ./apps/dashboard/package.json
COPY apps/mobile/package.json ./apps/mobile/package.json
COPY apps/worker/package.json ./apps/worker/package.json
COPY packages/ai-client/package.json ./packages/ai-client/package.json
COPY packages/config/package.json ./packages/config/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/mqtt/package.json ./packages/mqtt/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/ui/package.json ./packages/ui/package.json
RUN --mount=type=cache,id=michel-pnpm-store,target=/pnpm/store \
  pnpm install --frozen-lockfile --store-dir /pnpm/store
COPY . .

FROM dependencies AS builder
RUN pnpm db:generate && pnpm build \
  && pnpm --filter @michel/api deploy --prod /deploy/api \
  && pnpm --filter @michel/worker deploy --prod /deploy/worker

FROM dependencies AS dashboard-builder
COPY . .
RUN pnpm turbo run build --filter=@michel/dashboard...

FROM base AS api
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /deploy/api .
COPY docker/node-entrypoint.sh /usr/local/bin/michel-entrypoint
RUN chmod +x /usr/local/bin/michel-entrypoint && useradd --system --uid 10001 --create-home michel
USER michel
EXPOSE 3000
ENTRYPOINT ["michel-entrypoint"]
CMD ["node", "dist/main.js"]

FROM base AS worker
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /deploy/worker .
COPY docker/node-entrypoint.sh /usr/local/bin/michel-entrypoint
RUN chmod +x /usr/local/bin/michel-entrypoint && useradd --system --uid 10001 --create-home michel
USER michel
ENTRYPOINT ["michel-entrypoint"]
CMD ["node", "dist/main.js"]

FROM caddy:2.10-alpine AS dashboard
COPY --from=dashboard-builder /workspace/apps/dashboard/dist /srv
COPY docker/dashboard/Caddyfile /etc/caddy/Caddyfile
EXPOSE 8080
