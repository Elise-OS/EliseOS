:8080 {
  encode zstd gzip

  @remote_bootstrap {
    path /api/v1/auth/bootstrap /api/v1/auth/bootstrap-equipment
    not remote_ip private_ranges
  }
  respond @remote_bootstrap "La configuration d’Élise est disponible uniquement sur le réseau local." 403

  handle /api/* {
    reverse_proxy api:3000
  }

  handle_path /camera-media/* {
    forward_auth api:3000 {
      uri /api/v1/cameras/media-auth?ticket={query.ticket}&src={query.src}&talk={query.talk}&path={http.request.uri.path}
    }
    reverse_proxy go2rtc:1984
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(self), geolocation=()"
    Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self' data: blob:; media-src 'self' blob:; frame-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'"
  }
}
