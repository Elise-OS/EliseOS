:8080 {
  encode zstd gzip

  @remote_bootstrap {
    path /api/v1/auth/bootstrap /api/v1/auth/bootstrap-equipment
    not remote_ip private_ranges
  }
  respond @remote_bootstrap "La configuration d’Élise est disponible uniquement sur le réseau local." 403

  handle /api/* {
    reverse_proxy api:3000
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'"
  }
}
